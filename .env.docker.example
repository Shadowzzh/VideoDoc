# 复制成 .env 后填写，再执行：docker compose up -d --build
# 这里只有两个「必填」：图像识别（BaseURL + Key）与写文章的 LLM。

# ---- 图像识别（云端通道；容器里没有 macOS Vision，所以这一路是主力）----
VIDEODOC_VISION_PROTOCOL=openai-chat
VIDEODOC_VISION_BASE_URL=https://api.openai.com/v1
VIDEODOC_VISION_MODEL=gpt-4o-mini
VIDEODOC_VISION_API_KEY=
# 每任务最多分析多少张配图 / 每日硬预算（防打爆额度）
VIDEODOC_VISION_MAX_FRAMES=12
VIDEODOC_VISION_DAILY_BUDGET=200

# ---- 写文章用的 LLM ----
VIDEODOC_LLM_BASE_URL=https://api.deepseek.com
VIDEODOC_LLM_MODEL=deepseek-v4-flash
VIDEODOC_LLM_API_KEY=

# ---- 容器里读不到浏览器 cookie，默认关闭（需要登录态的站点请在宿主机运行）----
VIDEODOC_COOKIE_BROWSER=
