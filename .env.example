# VideoDoc 环境变量示例
#
# 用法：复制为 .env 后按需修改。
#   cp .env.example .env
#
# 优先级：真实环境变量 > .env 文件。也就是说已经 export 的变量不会被本文件覆盖。
# 可用 VIDEODOC_ENV_FILE 把 .env 指到别处：
#   VIDEODOC_ENV_FILE=/path/to/local.env
#
# 下面所有项都有内置默认值，全部留空也能启动（LLM 相关除外）。

# ---------------------------------------------------------------------------
# 运行数据
# ---------------------------------------------------------------------------

# 任务数据、转写、关键帧等运行产物存放目录。
# 默认：~/.local/share/videodoc
# VIDEODOC_RUNTIME_DIR=

# 前端构建产物目录。默认：<项目根>/frontend/dist
# VIDEODOC_FRONTEND_DIST=

# 监听地址与端口（仅 scripts/serve.sh 使用；videodoc 命令用 --host/--port）
# VIDEODOC_HOST=0.0.0.0
# VIDEODOC_PORT=8765

# ---------------------------------------------------------------------------
# LLM（生成大纲与正文，OpenAI 兼容接口）
# ---------------------------------------------------------------------------

# 必填：API Key。旧变量名 OPENCODE_GO_API_KEY 仍兼容。
# VIDEODOC_LLM_API_KEY=

# 默认：https://api.deepseek.com
# VIDEODOC_LLM_BASE_URL=

# 默认：deepseek-v4-flash（模型名时效性较强，可查询服务商 /models 接口确认）
# VIDEODOC_LLM_MODEL=

# 单次请求超时（秒），默认 600
# VIDEODOC_LLM_TIMEOUT=

# 瞬时错误（SSL/超时/断连）自动重试次数，默认 3。
# 链路抖动明显时可调高；设为 0 表示不重试。
# VIDEODOC_LLM_RETRIES=

# ---------------------------------------------------------------------------
# 转写（whisper.cpp）
# ---------------------------------------------------------------------------

# 模型名或本地 .bin 绝对路径。默认：large-v3-turbo（首次运行约需下载 1.5GB）
# VIDEODOC_WHISPER_MODEL=

# 模型搜索目录（可放多个 ggml-*.bin）
# VIDEODOC_WHISPER_MODEL_DIR=

# 已自行准备 whisper CLI 时，指向可执行文件即可跳过 pywhispercpp，
# 命令约定为：<bin> <audio.wav> -of <输出前缀>
# VIDEODOC_WHISPER_BIN=

# 识别语言。默认 auto（自动检测）；指定如 zh、en 可略微提速
# VIDEODOC_WHISPER_LANGUAGE=

# 推理线程数。默认 min(8, CPU 核数)
# VIDEODOC_WHISPER_THREADS=

# ---------------------------------------------------------------------------
# 关键帧抽取（claude-real-video）
# ---------------------------------------------------------------------------

# 覆盖 crv 可执行文件。默认用当前解释器执行 python -m claude_real_video
# VIDEODOC_CRV=

# 场景变化灵敏度 0-1，越低抽帧越多。默认 0.30
# VIDEODOC_FRAME_SCENE=

# 至少每 N 秒保留一帧。默认 3
# VIDEODOC_FRAME_FLOOR=

# 关键帧上限。默认 120
# VIDEODOC_MAX_FRAMES=

# 关键帧宽度（像素）。默认 960，画面文字小时可调高
# VIDEODOC_FRAME_WIDTH=

# ---------------------------------------------------------------------------
# OCR（本地取证，仅 macOS）
# ---------------------------------------------------------------------------

# 覆盖 OCR 脚本。默认使用随包内置的 macOS Vision 脚本
# VIDEODOC_OCR_SCRIPT=

# 最多对多少张章节配图做 OCR。默认 24
# VIDEODOC_OCR_MAX_FRAMES=

# ---------------------------------------------------------------------------
# 下载
# ---------------------------------------------------------------------------

# yt-dlp 读取哪个浏览器的登录态。默认 chrome；设为空字符串可完全禁用
# VIDEODOC_COOKIE_BROWSER=

# Bilibili 专用代理；部分代理出口会触发 HTTP 412，此时可指定直连或换出口
# VIDEODOC_BILIBILI_PROXY=

# Bilibili 请求使用的 User-Agent
# VIDEODOC_BILIBILI_USER_AGENT=

# 覆盖 yt-dlp 调用方式（默认用当前解释器执行 python -m yt_dlp）
# VIDEODOC_YT_DLP=
# VIDEODOC_YT_DLP_PYTHON=

# ---------------------------------------------------------------------------
# 调试
# ---------------------------------------------------------------------------

# 设为 1 时用内置假数据代替 LLM 调用，便于无 API Key 时试跑全流程
# VIDEODOC_FAKE_LLM=
